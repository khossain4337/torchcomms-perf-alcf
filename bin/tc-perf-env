#!/bin/bash
# tc-perf-env — per-rank environment shim. Runs INSIDE mpiexec, once per rank.
#
#     mpiexec --pmi=pmix -n $NRANKS -ppn $RPN  tc-perf-env  python ...
#
# WHY: the harness assumes torchrun. PBS/PALS exports PMIX_RANK and
# PALS_LOCAL_RANKID; torchcomms' get_rank_and_world_size() looks at
# OMPI_COMM_WORLD_*, RANK/WORLD_SIZE, SLURM_*, PMI_* -- and matches NONE of
# them. This maps one onto the other and then execs the real command.
#
# MUST be exported by the outer job script before mpiexec:
#     WORLD_SIZE, MASTER_ADDR, MASTER_PORT
# tc-perf-run does that for you.

set -euo pipefail

TCPERF_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../sites/common.sh
. "$TCPERF_ROOT/sites/common.sh"

# --- rank identity ----------------------------------------------------------
_rank="${PMIX_RANK:-${PALS_RANKID:-${RANK:-}}}"
_local_rank="${PALS_LOCAL_RANKID:-${MPI_LOCALRANKID:-${_rank:-0}}}"
_world="${WORLD_SIZE:-${PALS_NRANKS:-${PMI_SIZE:-}}}"

[ -n "$_rank" ]  || tcperf_die "cannot determine rank (no PMIX_RANK/PALS_RANKID/RANK)"
[ -n "$_world" ] || tcperf_die "WORLD_SIZE unset and no PALS_NRANKS/PMI_SIZE fallback.
    Export WORLD_SIZE from the job script before mpiexec."

export RANK="$_rank"
export WORLD_SIZE="$_world"
export LOCAL_RANK="$_local_rank"      # patch 0001 reads this for device binding

# The XCCL backend and existing site scripts read the TORCHCOMM_* trio directly.
export TORCHCOMM_RANK="$_rank"
export TORCHCOMM_SIZE="$_world"
export TORCHCOMM_LOCAL_RANK="$_local_rank"

# --- rendezvous (c10d adapters use init_method="env://") --------------------
# MASTER_ADDR must be IDENTICAL on every rank. Never derive it from `hostname`
# here: this script runs per-rank, so every rank would elect itself master.
if [ -z "${MASTER_ADDR:-}" ]; then
    if [ -n "${PBS_NODEFILE:-}" ] && [ -r "${PBS_NODEFILE}" ]; then
        MASTER_ADDR="$(tcperf_reachable "$(head -n 1 "$PBS_NODEFILE")")"
        export MASTER_ADDR
    else
        tcperf_die "MASTER_ADDR unset and no PBS_NODEFILE to derive it from.
    Export MASTER_ADDR from the job script (must match on all ranks)."
    fi
fi
export MASTER_PORT="${MASTER_PORT:-$TCPERF_MASTER_PORT}"

# --- harness knobs ----------------------------------------------------------
# Site profile already exported TEST_BACKEND/TEST_DEVICE and the CCL_*/ZE_*
# defaults; these lines only fill gaps if a profile was minimal.
export TEST_BACKEND="${TEST_BACKEND:-xccl}"
export TEST_DEVICE="${TEST_DEVICE:-xpu}"

# Silences oneCCL's local-topology warning.
export CCL_LOCAL_RANK="$_local_rank"
export CCL_LOCAL_SIZE="${PALS_LOCAL_SIZE:-${RPN:-$_world}}"

# This build REJECTS "tcp"/"pmix" here; unset lets it take the working "auto"
# path. Inherited from test2_job_script.sh, where we first hit it.
unset TORCHCOMM_XCCL_BOOTSTRAP_UNIQUEID_EXCHANGE_METHOD 2>/dev/null || true

export PYTHONUNBUFFERED=1

# --- provenance -------------------------------------------------------------
# Read by patch 0002 to fill the CSV's TorchCommsVersion column, which is
# otherwise useless on builds with no torchcomms.__version__.
export TORCHCOMMS_BUILD_TAG="${TORCHCOMMS_BUILD_TAG:-${FRAMEWORKS_VERSION:-${TCPERF_SITE}-unknown-build}}"

if [ "${TCPERF_VERBOSE:-0}" = "1" ] && [ "$_rank" = "0" ]; then
    echo "[tc-perf-env] site=$TCPERF_SITE rank=$RANK/$WORLD_SIZE local=$LOCAL_RANK" >&2
    echo "[tc-perf-env] master=$MASTER_ADDR:$MASTER_PORT backend=$TEST_BACKEND device=$TEST_DEVICE" >&2
    echo "[tc-perf-env] build_tag=$TORCHCOMMS_BUILD_TAG" >&2
fi

exec "$@"
